{
  "name": "meshcompute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "api:dev": "pnpm --filter @meshcompute/marketplace-api dev",
    "api:start": "pnpm --filter @meshcompute/marketplace-api start",
    "api:smoke": "pnpm --filter @meshcompute/marketplace-api smoke",
    "api:payment-smoke": "pnpm --filter @meshcompute/marketplace-api smoke:payment",
    "web:dev": "pnpm --filter @meshcompute/web dev",
    "web:build": "pnpm --filter @meshcompute/web build",
    "web:start": "pnpm --filter @meshcompute/web start",
    "provider:start": "pnpm --filter @meshcompute/provider-agent start",
    "consumer:start": "cross-env QVAC_WORKER_PATH=../../qvac/consumer-worker.entry.mjs pnpm --filter @meshcompute/consumer-agent start",
    "benchmark": "cross-env QVAC_WORKER_PATH=qvac/consumer-worker.entry.mjs tsx scripts/reliability-benchmark.ts",
    "benchmark:report": "tsx scripts/benchmark-to-markdown.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:reset": "tsx scripts/seed-demo.ts --reset",
    "qvac:doctor": "tsx spikes/doctor.ts",
    "spike:provider": "tsx spikes/provider.ts",
    "spike:consumer": "cross-env QVAC_WORKER_PATH=qvac/consumer-worker.entry.mjs tsx spikes/consumer.ts",
    "spike:adapter-consumer": "cross-env QVAC_WORKER_PATH=qvac/consumer-worker.entry.mjs tsx spikes/adapter-consumer.ts",
    "spike:tools": "cross-env QVAC_WORKER_PATH=qvac/consumer-worker.entry.mjs tsx spikes/tools.ts",
    "models:check": "tsx spikes/check-models.ts",
    "nat:check": "tsx spikes/nat-check.ts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test && vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@meshcompute/config": "workspace:*",
    "@meshcompute/contracts": "workspace:*",
    "@meshcompute/qvac-adapter": "workspace:*",
    "@qvac/sdk": "^0.17.1",
    "@types/node": "^22.18.0",
    "cross-env": "^10.0.0",
    "hyperdht": "6.33.1",
    "require-asset": "1.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "bare-runtime-win32-x64": "1.31.0"
  }
}
