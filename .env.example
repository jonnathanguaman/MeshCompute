PORT=4000
HOST=0.0.0.0
WEB_URL=http://localhost:3001
DATABASE_URL=./meshcompute.db
PROVIDER_OFFLINE_AFTER_MS=30000
PROVIDER_SWEEP_INTERVAL_MS=5000
PRICING_TIMEOUT_MS=3000
# Vigencia de un contrato de portal antes de pasar a EXPIRED (1 h por defecto).
CONTRACT_TTL_MS=3600000
LOG_LEVEL=info
PAYMENT_MODE=SIMULATED
# Liquida automaticamente cada job VERIFIED; false vuelve al settle manual.
AUTO_SETTLE=true
# true: liquida ceil(tokens/1000)*tarifa con los tokens reales; false: precio fijo.
SETTLE_BY_TOKENS=false
EVM_RPC_URL=
TESTNET_TOKEN_ADDRESS=
TREASURY_SEED_PHRASE=
TOKEN_DECIMALS=6
WDK_TESTNET_CHAIN_ID=11155111
WDK_ACCOUNT_INDEX=0
WDK_MAX_TRANSFER_ATOMIC=1000000
WDK_MAX_FEE_WEI=10000000000000000
WDK_RPC_TIMEOUT_MS=10000

NEXT_PUBLIC_MARKETPLACE_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_CONSUMER_AGENT_URL=http://127.0.0.1:5050
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_DEMO_MODE=true

# Provider Agent (PC que ejecuta el modelo)
MARKETPLACE_API_URL=http://127.0.0.1:4000
MARKETPLACE_DISABLED=false
PROVIDER_NAME=Gaming-PC-01
PROVIDER_WALLET=0x0000000000000000000000000000000000000001
PROVIDER_HARDWARE=RTX-4070
PROVIDER_MODEL_KEY=demo-llm
PROVIDER_MODEL_LABEL=Llama-3.2-1B-Instruct-Q4_0
PROVIDER_PRICE_ATOMIC=2000
PROVIDER_WARMUP_MODEL=true
QVAC_HYPERSWARM_SEED=
QVAC_FIREWALL_ALLOWED_KEYS=
GGML_DISABLE_VULKAN=
HEARTBEAT_INTERVAL_MS=10000
REGISTER_RETRY_MS=3000

# Consumer Agent (misma PC que la interfaz web)
CONSUMER_PORT=5050
WEB_ORIGIN=http://localhost:3001
QVAC_FIRST_CONNECT_TIMEOUT_MS=60000
QVAC_FALLBACK_TO_LOCAL=false
QVAC_ADAPTER=real
CONSUMER_MODEL_KEY=demo-llm
# Seguro con cualquier modelo: el orchestrator solo se activa si el modelo
# del provider soporta tools; con demo-llm se usa el camino simple.
RELIABILITY_ENABLED=true
MAX_TOOL_TURNS=4
MAX_TOOL_RETRIES=1
MAX_FINAL_SCHEMA_RETRIES=1
TOOL_TIMEOUT_MS=10000
RELIABILITY_BENCHMARK_MODE=hardened
